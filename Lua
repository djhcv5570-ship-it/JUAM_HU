-- ===== Estado de las posiciones =====
local tp1CFrame = nil
local tp2CFrame = nil

-- ===== Función para crear botón =====
local function createButton(text, color, order, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 42)
    btn.BackgroundColor3 = color
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = text
    btn.LayoutOrder = order
    btn.Parent = list
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

-- ===== TP 1 =====
createButton("Guardar TP 1", Color3.fromRGB(30, 52, 92), 1, function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        tp1CFrame = hrp.CFrame
        print("TP 1 guardado")
    end
end)

createButton("Ir a TP 1", Color3.fromRGB(200, 30, 30), 2, function()
    if tp1CFrame then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = tp1CFrame
        end
    end
end)

